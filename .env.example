# Copy this file to .env and fill in both values.
# Until both are set the app runs in demo mode against fixture data.

# Supabase dashboard → Settings → API Keys → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Settings → API Keys
# New projects: the "publishable" key, starts with sb_publishable_
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects issue a legacy "anon" JWT instead (starts with eyJ).
# Either one works — set whichever your dashboard shows.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the secret / service_role key in this file. It bypasses all
# row-level security, and everything here is compiled into the client bundle
# that ships to phones. The publishable key is designed to be public — RLS is
# what protects the data, not the secrecy of that key.
